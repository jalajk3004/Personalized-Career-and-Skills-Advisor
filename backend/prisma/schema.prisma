generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model career_options {
  career_id        Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  description      String
  salary_range_min Int?
  salary_range_max Int?
  currency         String?   @default("INR") @db.VarChar(10)
  required_skills  String[]
  growth_rate      Decimal?  @db.Decimal(5, 2)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  user_id          Int?
  users            users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([name], map: "idx_career_options_name")
  @@index([salary_range_min, salary_range_max], map: "idx_career_options_salary")
}

model career_recommendations {
  recommendation_id     Int       @id @default(autoincrement())
  user_id               Int
  name                  String    @db.VarChar(100)
  age                   Int?
  highschool_name       String?   @db.VarChar(150)
  highschool_stream     String?   @db.VarChar(50)
  college               String?   @db.VarChar(150)
  course_type           String?   @db.VarChar(50)
  course                String?   @db.VarChar(100)
  specialisation        String?   @db.VarChar(100)
  no_experience         Boolean?  @default(false)
  job_title             String?   @db.VarChar(100)
  company_name          String?   @db.VarChar(100)
  duration              String?   @db.VarChar(50)
  skills                String?
  interests             String?
  preferred_work_env    String?   @db.VarChar(50)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  ai_questions          Json?     @db.Json
  ai_answers            Json?     @db.Json
  final_recommendations Json?     @db.Json
  users                 users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
}

model form_sessions {
  session_id              Int       @id @default(autoincrement())
  user_id                 Int
  current_step            Int
  total_steps             Int
  ai_questions_generated  Boolean   @default(false)
  is_completed            Boolean   @default(false)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  users                   users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model form_questions {
  question_id      Int            @id @default(autoincrement())
  user_id          Int?
  question_text    String         @db.Text
  question_type    String         @db.VarChar(50)
  options          Json?          @db.Json
  is_ai_generated  Boolean        @default(false)
  order_sequence   Int            @default(0)
  is_required      Boolean        @default(true)
  category         String         @db.VarChar(100)
  form_answers     form_answers[]
  users            users?         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model form_answers {
  answer_id      Int            @id @default(autoincrement())
  user_id        Int
  question_id    Int
  answer_text    String?        @db.Text
  answer_json    Json?          @db.Json
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  updated_at     DateTime?      @default(now()) @db.Timestamp(6)
  users          users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  form_questions form_questions @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  
  @@unique([user_id, question_id])
}

model users {
  user_id                Int                      @id @default(autoincrement())
  email                  String                   @unique @db.VarChar(255)
  uid                    String                   @unique @db.VarChar(255)
  password_hash          String?                  @db.VarChar(255)
  career_options         career_options[]
  career_recommendations career_recommendations[]
  form_sessions          form_sessions[]
  form_questions         form_questions[]
  form_answers          form_answers[]
}
